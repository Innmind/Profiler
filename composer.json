{
    "name": "innmind/profiler",
    "type": "library",
    "description": "App profiler",
    "keywords": ["profiler", "http", "cli"],
    "homepage": "http://github.com/Innmind/Profiler",
    "license": "MIT",
    "authors": [
        {
            "name": "Baptiste Langlade",
            "email": "baptiste.langlade@hey.com"
        }
    ],
    "support": {
        "issues": "http://github.com/Innmind/Profiler/issues"
    },
    "require": {
        "php": "~8.4",
        "innmind/foundation": "~2.1",
        "innmind/framework": "^4.0.1",
        "innmind/url-template": "~4.0",
        "ramsey/uuid": "~4.7"
    },
    "autoload": {
        "psr-4": {
            "Innmind\\Profiler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Innmind\\Profiler\\": "tests/"
        }
    },
    "require-dev": {
        "innmind/static-analysis": "~1.3",
        "innmind/black-box": "~6.5",
        "innmind/coding-standard": "~2.0"
    },
    "provide": {
        "innmind/framework-middlewares": "4.0"
    },
    "conflict": {
        "innmind/xml": "<9.1"
    }
}
